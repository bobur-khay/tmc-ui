# Copy to .env and remove/comment out the variables of modes you don't need.


# Client mode
CATALOG_REPO_URLS=https://github.com/wot-oss/example-catalog.git

# Server mode
TMC_SERVER_URL=http://localhost:8080

# Authentication
TOKEN_URL=http://localhost:8081/oauth2/token
CREDENTIALS_SETUP_MESSAGE="Email <your-email@example.com> for API credentials"

# Static Mode
IS_STATIC=true
BASE_PATH=/tmc-ui
# Only for static export with authentication (build-time inventory access):
CLIENT_ID=
CLIENT_SECRET=

# --- Optional ---
EDITDOR_URL=https://eclipse-editdor.github.io/editdor/
PLAYGROUND_URL=https://playground.thingweb.io/
DEBUG=true