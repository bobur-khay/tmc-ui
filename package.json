{
  "name": "tmc-ui",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Web interface for browsing Thing Models managed by TMC",
  "repository": {
    "type": "git",
    "url": "https://github.com/wot-oss/tmc-ui.git"
  },
  "homepage": "https://github.com/wot-oss/tmc-ui",
  "bugs": {
    "url": "https://github.com/wot-oss/tmc-ui/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start",
    "catalogs-for-ui": "node --experimental-strip-types ci-cd/catalogs-for-ui.ts",
    "ui-for-catalog": "node --experimental-strip-types ci-cd/ui-for-catalog.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:integration:static": "vitest run tests/integration/static",
    "test:integration:backend-no-auth": "vitest run tests/integration/backend-no-auth",
    "test:integration:backend-with-auth": "vitest run tests/integration/backend-with-auth",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run test:e2e:static && pnpm run test:e2e:server",
    "test:e2e:static": "playwright test -c tests/e2e/static.config.ts",
    "test:e2e:server": "playwright test -c tests/e2e/server.config.ts",
    "test:e2e:install": "playwright install chromium firefox",
    "test:all": "pnpm run test:coverage && pnpm run test:e2e",
    "clean": "rm -rf node_modules dist build && pnpm install --frozen-lockfile && pnpm run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "setup:local": "pnpm install --frozen-lockfile && pnpm run build && pnpm run start"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "lodash": "^4.18.1",
    "next": "16.3.4",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wot-typescript-definitions": "^0.8.0-SNAPSHOT.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
